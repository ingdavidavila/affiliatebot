# Copy this file to .env and fill in the keys you have. (.env is ignored by git.)
# Leave a line empty if you don't use that service yet.

# X (Twitter) - developer.x.com > your app > Keys and tokens.
# The app needs "Read and write" permission; regenerate the access token after changing it.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# eBay - developer.ebay.com > Application keys (Production)
EBAY_APP_ID=
EBAY_CERT_ID=
# eBay Partner Network - partnernetwork.ebay.com > Campaigns
EPN_CAMPAIGN_ID=

# Amazon Associates store tag, e.g. yourname-20
AMAZON_ASSOCIATE_TAG=
